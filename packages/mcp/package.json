{
  "name": "@blendia/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP tools for a live Blender session and owned project execution.",
  "main": "src/index.ts",
  "bin": {
    "blendia-mcp": "lib/bin.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./native-bootstrap": "./nativeBootstrap.cjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf lib && node --require ../../config/nativeBootstrap.cjs ../../node_modules/ttsc/lib/launcher/ttsc.js",
    "start": "node --require ./nativeBootstrap.cjs ../../node_modules/ttsc/lib/launcher/ttsx.js src/bin.ts",
    "prepack": "pnpm run build",
    "lint": "node --require ../../config/nativeBootstrap.cjs ../../node_modules/ttsc/lib/launcher/ttsx.js ../../config/checkLint.ts",
    "evidence": "node --require ../../config/nativeBootstrap.cjs ../../node_modules/@wrtnlabs/evidence/lib/executable/evidence.js"
  },
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/blendia",
    "directory": "packages/mcp"
  },
  "files": [
    "lib",
    "src",
    "nativeBootstrap.cjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "bin": {
      "blendia-mcp": "lib/bin.js"
    },
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./native-bootstrap": "./nativeBootstrap.cjs",
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@blendia/runtime": "workspace:^",
    "@blendia/sdk": "workspace:^",
    "@modelcontextprotocol/sdk": "catalog:samchon",
    "@typia/mcp": "catalog:samchon",
    "typia": "catalog:samchon"
  },
  "devDependencies": {
    "@ttsc/evidence": "catalog:samchon",
    "@ttsc/lint": "catalog:samchon",
    "@types/node": "catalog:utils",
    "@wrtnlabs/evidence": "catalog:samchon",
    "rimraf": "catalog:utils",
    "ttsc": "catalog:samchon",
    "typescript": "catalog:typescript"
  }
}
