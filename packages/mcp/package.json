{
  "name": "@blendia/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP tools for a live Blender session and owned project execution.",
  "main": "src/index.ts",
  "bin": {
    "blendia-mcp": "lib/bin.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf lib && ttsc",
    "start": "ttsx src/bin.ts",
    "prepack": "pnpm run build",
    "lint": "ttsx ../../config/checkLint.ts",
    "evidence": "evidence"
  },
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/blendia",
    "directory": "packages/mcp"
  },
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "bin": {
      "blendia-mcp": "lib/bin.js"
    },
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@blendia/runtime": "workspace:^",
    "@blendia/sdk": "workspace:^",
    "@modelcontextprotocol/sdk": "catalog:samchon",
    "@typia/mcp": "catalog:samchon",
    "typia": "catalog:samchon"
  },
  "devDependencies": {
    "@ttsc/evidence": "catalog:samchon",
    "@ttsc/lint": "catalog:samchon",
    "@types/node": "catalog:utils",
    "@wrtnlabs/evidence": "catalog:samchon",
    "rimraf": "catalog:utils",
    "ttsc": "catalog:samchon",
    "typescript": "catalog:typescript"
  }
}
