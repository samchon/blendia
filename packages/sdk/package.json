{
  "name": "@blendia/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Typed async connection to a live Blender session for project TypeScript scripts.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf lib && node --require ../../config/nativeBootstrap.cjs ../../node_modules/ttsc/lib/launcher/ttsc.js",
    "prepack": "pnpm run build",
    "lint": "node --require ../../config/nativeBootstrap.cjs ../../node_modules/ttsc/lib/launcher/ttsx.js ../../config/checkLint.ts",
    "evidence": "node --require ../../config/nativeBootstrap.cjs ../../node_modules/@wrtnlabs/evidence/lib/executable/evidence.js"
  },
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/blendia",
    "directory": "packages/sdk"
  },
  "files": ["lib", "src", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "@ttsc/evidence": "catalog:samchon",
    "@ttsc/lint": "catalog:samchon",
    "@types/node": "catalog:utils",
    "@wrtnlabs/evidence": "catalog:samchon",
    "rimraf": "catalog:utils",
    "ttsc": "catalog:samchon",
    "typescript": "catalog:typescript"
  }
}
