{
  "private": true,
  "name": "@blendia/workspace",
  "version": "0.1.0",
  "description": "TypeScript tooling for the existing Blender application.",
  "packageManager": "pnpm@10.6.4",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "blendia": "node --require ./config/nativeBootstrap.cjs ./node_modules/ttsc/lib/launcher/ttsx.js packages/cli/src/bin.ts",
    "extension:license": "node --require ./config/nativeBootstrap.cjs ./node_modules/ttsc/lib/launcher/ttsx.js config/prepareExtensionLicense.ts",
    "build": "pnpm --filter=./packages/** -r build",
    "config:check": "pnpm --filter @blendia/config build",
    "lint": "pnpm --filter=./config --filter=./packages/** --filter=./tests/** --no-bail -r lint",
    "test": "pnpm run test:units",
    "test:units": "pnpm --filter @blendia/test-units start",
    "test:blender": "pnpm --filter @blendia/test-blender start",
    "test:types": "pnpm --filter=./tests/** --no-bail -r build",
    "test:units:types": "pnpm --filter @blendia/test-units build",
    "test:blender:types": "pnpm --filter @blendia/test-blender build",
    "format": "prettier --write \"**/*.{ts,cts,mts,cjs}\"",
    "format:check": "prettier --check \"**/*.{ts,cts,mts,cjs}\"",
    "evidence": "pnpm --filter=./packages/** --filter=./tests/** --no-bail --no-sort -r --if-present evidence"
  },
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/blendia"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "catalog:typescript",
    "@ttsc/evidence": "catalog:samchon",
    "@ttsc/lint": "catalog:samchon",
    "@types/node": "catalog:utils",
    "@wrtnlabs/evidence": "catalog:samchon",
    "prettier": "catalog:typescript",
    "rimraf": "catalog:utils",
    "ttsc": "catalog:samchon",
    "typescript": "catalog:typescript"
  }
}
